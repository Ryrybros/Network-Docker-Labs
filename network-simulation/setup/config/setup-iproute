#!/bin/bash

# Enable packet forwarding inside the router container
podman exec firewall-router sysctl -w net.ipv4.ip_forward=1

# 1. Flush existing FORWARD rules to ensure a clean slate
podman exec firewall-router iptables -F FORWARD


podman exec firewall-router iptables -A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT


podman exec firewall-router iptables -P FORWARD DROP

#Allow new connect from 55
podman exec firewall-router iptables -A FORWARD -s 192.168.55.0/24 -d 192.168.53.0/24 -m conntrack --ctstate NEW -j ACCEPT

podman exec firewall-router iptables -A FORWARD -s 192.168.55.0/24 -d 192.168.52.0/24 -m conntrack --ctstate NEW -j ACCEPT

#Allow internet access for interns
podman exec firewall-router iptables -A FORWARD -s 192.168.55.0/24 -d 192.168.56.0/24 -m conntrack --ctstate NEW -j ACCEPT


